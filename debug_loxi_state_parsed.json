                  "filterTabKey": null,
                  "icon": "//cdnimg-v2.gamekee.com/wiki2.0/images/w_117/h_114/50248/103682/2026/2/2/938334.png",
                  "name": {
                    "type": "simpleEditor",
                    "data": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "血红之影-战技"
                          }
                        ]
                      }
                    ]
                  },
                  "label": "",
                  "desc": {
                    "type": "simpleEditor",
                    "data": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "冲向敌方目标，以利爪发起攻击，对其造成伤害并施加击飞。"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "若目标身上已有破防，则会额外追加伤害，并给目标留下爪印斫痕，在一段时间内造成持续伤害。"
                          }
                        ]
                      }
                    ]
                  },
                  "moreInfo": "",
                  "moreBtn": "查看升级效果",
                  "iconSize": {
                    "width": "60px",
                    "height": "60px"
                  }
                },
                {
                  "key": "0.1105a10f3d27e8",
                  "isShowIcon": true,
                  "isShowName": true,
                  "isShowDesc": true,
                  "isShowMore": false,
                  "filterTabKey": null,
                  "icon": "//cdnimg-v2.gamekee.com/wiki2.0/images/w_114/h_111/50248/103682/2026/2/2/392644.png",
                  "name": {
                    "type": "simpleEditor",
                    "data": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "燎影时刻-连携技"
                          }
                        ]
                      }
                    ]
                  },
                  "label": "",
                  "desc": {
                    "type": "simpleEditor",
                    "data": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "当有敌人同时处于破防和法术附着状态时可以发动。"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "洛茜的连携技可连续发动两次，第一次对目标造成伤害，第二次将消耗目标全部的法术附着，造成伤害并将其击飞。"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "text": "当第二次连携技精准衔接时，可额外为目标施加一层破防。"
                          }
                        ]
                      }
                    ]
                  },
                  "moreInfo": "",
                  "moreBtn": "查看升级效果",
                  "iconSize": {
                    "width": "60px",
                    "height": "60px"
                  }
                },
